#! /usr/bin/env loki

# Uninstalls from the default locations

INSTALL_ROOT="/usr/local/bin"

if [[ "$1" == update ]]; then
    update="YES"
fi

#################################################################

version=$(fenrir-read-conf main version)
loki-log info "Uninstalling fenrir v${version}"

#################################################################

if [ "$(id -u)" -ne 0 ]; then
    loki-log err "The script must be run in a $(loki-wrap "${BOLD}" "privileged mode") (sudo)!"
    exit 111
fi

#################################################################

loki-prog "Removing working directories.."

if [ -z "${update}" ]; then
    if [ -d "${FENRIR_TMP_DIR}" ]; then
        rm -r "${FENRIR_TMP_DIR}"
    else
        loki-log warn "fenrir's tmp directory was not found!"
    fi
fi

if [ -z "${FENRIR_KEEP_LOCAL_REPO}" ]; then
    if [ -d "${FENRIR_HOME}" ]; then
        rm -r "${FENRIR_HOME}"
    else
        loki-log warn "fenrir's local repository was not found!"
    fi
fi

loki-gorp

#################################################################

loki-prog "Removing man pages.."

for cmd in /usr/local/share/man/man1/fenrir-* /usr/local/share/man/man1/loki*; do
    if [ "$cmd" = "/usr/local/share/man/man1/fenrir-*" ]; then
        loki-log warn "No core commands were found!"
        break
    fi

    rm -f "$cmd"
done

loki-gorp

#################################################################

if [ -z "${update}" ]; then
    loki-prog "Removing '/etc/fenrir'.."

    if [ -d "/etc/fenrir" ]; then
        rm -r /etc/fenrir
    else
        loki-log warn "The directory does not exist!"
    fi

    loki-gorp
fi

#################################################################
loki-prog "Removing Loki.."

if [ -f "${INSTALL_ROOT}/loki" ]; then
    rm -fr "${INSTALL_ROOT}/loki"
fi

loki-gorp
#################################################################
loki-prog "Removing core.."

for cmd in "${INSTALL_ROOT}"/fenrir-*; do
    if [ "$cmd" = "${INSTALL_ROOT}/fenrir-*" ]; then
        loki-log warn "No core commands were found!"
        break
    fi

    if ! rm "$cmd"; then
        loki-log err "Terminating.."
        exit 10
    fi
done

if [ -f "${INSTALL_ROOT}/update-fenrir" ]; then
    rm "${INSTALL_ROOT}/update-fenrir"
fi

loki-gorp
#################################################################
loki-prog "Removing cli tool.."

if [ -f "${INSTALL_ROOT}/fenrir" ]; then
    rm "${INSTALL_ROOT}/fenrir"
else
    loki-log warn "fenrir cli is not installed"
fi

loki-gorp

# Remove the script itself
rm -fr "${INSTALL_ROOT}/uninstall-fenrir"
