#compdef _fenrir fenrir

# Read: https://blog.mads-hartmann.com/2017/08/06/writing-zsh-completion-scripts.html

function _fenrir {
    local line

    _arguments -C \
        "--help[Show help information]" \
        "1:subcommand:((
            h\:'Show help information'
            help\:'Show help information'
            i\:'Show execution context'
            info\:'Show execution context'
            remote\:'Set tasks remote repository'
            v\:'Show current version'
            version\:'Show current version'
            versions\:'Show all supported versions'
            gc\:'Remove unused files'
            switch\:'Update fenrir'
            run\:'Run tests'
            rund\:'Run tests in a docker container'
            task\:'Set the task to be tested'
            il\:'Install a script as _local_ task'
            install\:'Install a script as _local_ task'
            in\:'Show test sources'
            inspect\:'Show test sources'
            env\:'Manage dev environment'
            ))" \
        "*::arg:->args"
    
    case $line[1] in
        gc)
            _fenrir_gc
        ;;
        switch)
            _fenrir_switch
        ;;
        run)
            _fenrir_run
        ;;
        rund)
            _fenrir_rund
        ;;
        task)
            _fenrir_task
        ;;
        il)
            _fenrir_install
        ;;
        install)
            _fenrir_install
        ;;
        in)
            _fenrir_inspect
        ;;
        inspect)
            _fenrir_inspect
        ;;
        env)
            _fenrir_env
        ;;
    esac
}

function _fenrir_gc {
    _arguments -C \
        "-f[Run in HARD mode]" \
        "--force[Run in HARD mode]"
}

function _fenrir_switch {
    _arguments -C \
        "--zsh[Install autocompletion for zsh]" \
        "--bash[Install autocompletion for bash]" \
        "1:Switch to the latest version:(latest)"
}

function _find_all_tasks {
    dir=$(fenrir-task-path repo 2> /dev/null)

    find "$(echo "$dir" | sed 's|\(.*/repo\).*|\1|')" -mindepth 1 -type d -print0 | while IFS= read -r -d '' d; do
        find "$d" -mindepth 1 -type d -print -quit | grep -q . || echo "$d" | sed 's|.*/repo/\(.*\)|\1|'
    done
}

function _find_all_tests {
    dir=$(fenrir-task-path repo 2> /dev/null)
    if ! [ -d "$dir" ]; then
        return 0
    fi

    find "$dir" -type f -print0 | while IFS= read -r -d '' d; do
        echo "$d" | grep -vE ".*\.hel" | sed 's|.*/\([^/]*\)|\1|'
    done
}

function _fenrir_env {
    _arguments -C \
        "-c[Select the testcase to enter]:testcase:($(_find_all_tests))" \
        "--testcase[Select the testcase to enter]:testcase:($(_find_all_tests))" \
        "1:subcommand::((
            up\:'Enter dev environment'
            down\:'Destroy current dev environment'
            ))" \
        "*::arg:->arfs"
    
    case $line[1] in
        up)
            _arguments -C "1:Solution directory:_path_files -/"
        ;;
    esac
}

function _fenrir_run {
    _arguments -C \
        "-i[Run test inside the provided directory without cloning it]" \
        "-nl[Skip linting stage (walk-inspections)]" \
        "--no-lint[Skip linting stage (walk-inspections)]" \
        "-c[Select the testcase to run]:testcase:($(_find_all_tests))" \
        "--testcase[Select the testcase to run]:testcase:($(_find_all_tests))" \
        "1:Solution directory:_path_files -/"
}

function _fenrir_rund {
    _arguments -C \
        "-d[Do not stop the container (allows further debug)]" \
        "--debug[Do not stop the container (allows further debug)]" \
        "-nl[Skip linting stage (walk-inspections)]" \
        "--no-lint[Skip linting stage (walk-inspections)]" \
        "-c[Select the testcase to run]:testcase:($(_find_all_tests))" \
        "--testcase[Select the testcase to run]:testcase:($(_find_all_tests))" \
        "1:Solution directory:_path_files -/"
}

function _fenrir_task {
    _arguments -C \
        "-f[Download tests anyway]" \
        "--force[Download tests anyway]" \
        "1:Select task:($(_find_all_tasks))"
}

function _fenrir_install {
    _arguments -C "1:Path to the script:_files"
}

function _fenrir_inspect {
    _arguments -C \
        "1:Select test:($(_find_all_tests))"
}
