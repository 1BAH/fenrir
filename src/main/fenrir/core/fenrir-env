#! /usr/bin/env loki

##
# Usage:
#   fenrir-env [-c|--testcase TESTCASE] (up DIR|down)
#
# TODO
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

#include <verify-non-sudo>
#include <shift-args>

variant=""

while (( $# > 0 )); do
    case $1 in
        -c|--testcase)
            testcase=${2?"$(loki-ej-fail) You must select the testcase!"}
            shift
        ;;
        up)
            variant=up
            path=${2?"$(loki-ej-fail) You must provide a directory!"}
            shift
        ;;
        down)
            variant=down
        ;;
        *)
            loki-log err "$(loki-ej-wtf)" "Unknown argument: <$1>"
            loki-log err "Expected <up> or <down>"
            exit 11
        ;;
    esac
    shift
done

if [ -z "$variant" ]; then
    loki-log err "$(loki-ej-fail)" "You must choose: <up> or <down>"
    exit 12
fi

######################################################################
##                           DOWN PROGRAM                           ##
######################################################################

if [ "$variant" = "down" ]; then
    # shellcheck disable=SC2086
    fenrir-env-down
    exit
fi

######################################################################
##                            UP PROGRAM                            ##
######################################################################

recreate=YES

if [ -n "$(fenrir-main-cont)" ]; then
    loki-log warn "$(loki-ej-wtf)" "Found an existing environment. Choose what to do:"
    echo "   $(loki-wrap "${BLUE}" "[R]")   $(loki-wrap "${ULINE}" "Reload") the previous environment"
    echo "   $(loki-wrap "${BLUE}" "[D]")   $(loki-wrap "${ULINE}" "Delete") the previous environment"
    echo "   $(loki-wrap "${BLUE}" "[N]")   Remove the previous one and start a $(loki-wrap "${ULINE}" "new") one"
    echo "   $(loki-wrap "${BLUE}" "[E]")   $(loki-wrap "${ULINE}" "Exit")"

    read -r op
    while true; do
        case $op in
            R|r)

                while IFS= read -r cont; do
                    lokiw docker restart "$cont" || {
                        loki-log fail "$(loki-ej-fail)" "An error occurred while reloading the env"
                        loki-log fault "Remove the previous env and create a new one!"
                        exit 5
                    }
                done < <(docker ps -aq --filter label="${FENRIR_DOCKER_LABEL}")

                recreate=""
                break
            ;;
            N|n)
                fenrir-env-down
                break
            ;;
            D|d)
                fenrir-env-down
                exit
            ;;
            E|e)
                exit 0
            ;;
            *)
                loki-log fault "$(loki-ej-wtf)" "Unknown option: <$op>. Try again"
                read -r op
            ;;
        esac
    done
fi

if [ -n "$recreate" ]; then
    if ! [ -d "$path" ]; then
        loki-log err "Invalid path: <$path> is not a directory!"
        exit 99
    fi
    fenrir-set-conf run root "$(realpath "$path")"

    task=$(fenrir-read-conf run task)
    if [ "$task" = "-" ]; then
        loki-log err "$(loki-ej-fail)" "The task was not set!"
        exit 89
    fi

    if ! [ -d "$(fenrir-task-path repo)" ]; then
        loki-log err "$(loki-ej-fail)" "Task <$task> is not installed!"
        loki-log err "Install it via 'fenrir task $task' to be able to enter the environment"
        exit 77
    fi

    fenrir-env-up --bind --unsafe
fi

# Run only when the env is ready
container=$(fenrir-main-cont)
if [ -n "${container}" ]; then
    # shellcheck disable=SC2086
    docker exec -u fikus -it "$container" fenrir-env-runner $testcase

    loki-log info "Suspending env.."
    # shellcheck disable=SC2046
    lokiw docker stop $(docker ps -q --filter label="${FENRIR_DOCKER_LABEL}")

    loki-log info "$(loki-ej-success)" "Goodbye!"
else
    loki-log warn "$(loki-ej-wtf)" "Found problems when creating env"
    fenrir-env-down
fi
