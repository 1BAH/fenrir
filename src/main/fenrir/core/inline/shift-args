##
# Usage:
#   #include <shift-args>
#
# Shifts the args when it is required (since we use custom interpreter).
##

# Symlinks must be resolved
if realpath "$1" &> /dev/null; then
    if [[ $(realpath "$1") == $(realpath "${BASH_SOURCE[0]}") ]]; then
        shift
    fi
fi

