#! /usr/bin/env loki

##
# Usage:
#   fenrir-info
#
# Show the current context of fenrir:
#   - Tasks' remote repo
#   - The task to be tested
#   - Running mode of the task (whether is blocking or not)
#   - Testing pipeline
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

#include <shift-args>
#include <help>

EXP_ARGC=0
#include <verify-argc>

######################################################################
##                           MAIN PROGRAM                           ##
######################################################################

echo "$FENRIR_LOGO"

curr_task=$(fenrir-read-conf run task)

pipeline=""
if [ -f "${FENRIR_HOME}/repo/${curr_task}/pipeline.hel" ]; then
    pipeline=$(< "${FENRIR_HOME}/repo/${curr_task}/pipeline.hel")
    inline=$(fenrir-read-conf "${curr_task}" inline)
    inhost=$(fenrir-read-conf "${curr_task}" inhost)
    indocker=$(fenrir-read-conf "${curr_task}" indocker)
elif [ "$curr_task" != "-" ]; then
    loki-log err "Found invalid state of task '${curr_task}'. It's strongly recommended to rerun 'fenrir task ${curr_task}'."
    inline="?"
    inhost="?"
    indocker="?"
fi


cat <<____HEREDOC
$(loki-dup '-' "${LOKI_COLUMNS}")
Current settings:
    * Remote: $(fenrir-read-conf main remote)
    * Current task: ${curr_task}
    * Blocking: $(fenrir-read-conf run blocking)
    * Execution mode: ${inline:-1}${inhost:-1}${indocker:-1} (Inline-Host-Docker)
$(loki-dup '-' "${LOKI_COLUMNS}")
Run settings:
$([ -n "${pipeline}" ] && loki-wrap "${YELLOW}" "${pipeline}")
$(loki-dup '-' "${LOKI_COLUMNS}")
fenrir $(fenrir-read-conf main version), 2026
@1BAH
____HEREDOC
