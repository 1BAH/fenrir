#! /usr/bin/env bash


_fenrir()
{
    function _find_all_tasks {
        dir=$(fenrir-task-path repo 2> /dev/null)

        find "$(echo "$dir" | sed 's|\(.*/repo\).*|\1|')" -mindepth 1 -type d -print0 | while IFS= read -r -d '' d; do
            find "$d" -mindepth 1 -type d -print -quit | grep -q . || echo "$d" | sed 's|.*/repo/\(.*\)|\1|'
        done
    }

    function _find_all_tests {
        dir=$(fenrir-task-path repo 2> /dev/null)
        if ! [ -d "$dir" ]; then
            return 0
        fi

        find "$dir" -type f -print0 | while IFS= read -r -d '' d; do
            echo "$d" | grep -vE ".*\.hel" | sed 's|.*/\([^/]*\)|\1|'
        done
    }

    local IFS=$' \t\n'    # normalize IFS
    local cmd_len=17
    local printfstr="%-${cmd_len}s -- %-$(( COLUMNS - cmd_len - 20 ))s"

    local -A helpmsg
    helpmsg=(
        [help]="Show help information"
        [info]="Show execution context"
        [remote]="Set task remote repository"
        [version]="Show current version"
        [versions]="Show all supported versions"
        [gc]="Remove unused files"
        [switch]="Update fenrir"
        [run]="Run tests"
        [rund]="Run tests in a docker container"
        [task]="Set the task to be tested"
        [install]="Install a script as 'local' task"
        [inspect]="Show test sources"
        [env]="Manage dev environment"
    )

    local -A display_name_map
    display_name_map=(
        [help]="help, --help, h"
        [info]="info, i"
        [remote]="remote"
        [version]="version, v"
        [versions]="versions"
        [gc]="gc"
        [switch]="switch"
        [run]="run"
        [rund]="rund"
        [task]="task"
        [install]="install, il"
        [inspect]="inspect, in"
        [env]="env"
    )

####################################################################################################
    if (( COMP_CWORD == 1 )); then # Select cmd
        CMDS=("remote")
        CMDS+=("gc")
        CMDS+=("help" "--help" "h")
        CMDS+=("i" "info")
        CMDS+=("v" "version")
        CMDS+=("versions")
        CMDS+=("switch")
        CMDS+=("run" "rund")
        CMDS+=("task")
        CMDS+=("install" "il")
        CMDS+=("inspect" "in")
        CMDS+=("env")

        local output=()
        local raw=()
        local -A inuse

        for cmd in $(compgen -W "${CMDS[*]}" -- "${COMP_WORDS[COMP_CWORD]}"); do
            local long_cmd="$cmd"

            case "$cmd" in
                i)  long_cmd="info" ;;
                h)  long_cmd="help" ;;
                v)  long_cmd="version" ;;
                il) long_cmd="install" ;;
                in) long_cmd="inspect" ;;
            esac

            local desc=${helpmsg["$long_cmd"]}
            local display_name="${display_name_map["$long_cmd"]}"

            if ! [[ "${inuse["$long_cmd"]+_}" ]] && [ -n "$display_name" ]; then
                output+=("$(printf "$printfstr" "$display_name" "$desc")")
                raw+=("$cmd")
                inuse["$long_cmd"]=1
            fi
        done

        if [ "${#raw[@]}" -eq 0 ]; then
            return 0
        fi

        # When the command is found, there is no need for info message
        if [ "${#raw[@]}" -eq 1 ]; then
            COMPREPLY=("${raw[0]}")
            return 0
        fi

        COMPREPLY=("${output[@]}")
####################################################################################################
