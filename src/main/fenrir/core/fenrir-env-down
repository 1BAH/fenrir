#! /usr/bin/env loki

##
# Usage:
#   fenrir-env-down
#
# TODO
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

#include <shift-args>

EXP_ARGC=0
#include <verify-argc>

######################################################################
##                           MAIN PROGRAM                           ##
######################################################################

loki-log info "Destructing the env.."

loki-log info "+ env.down"
# Env teardown
if [ -x "$(fenrir-task-path repo)/env.down" ]; then
    "$(fenrir-task-path repo)/env.down"
fi

loki-log info "+ Containers"
# shellcheck disable=SC2046
lokiw docker rm -f $(docker ps -aq --filter label="${FENRIR_DOCKER_LABEL}")

loki-log info "+ Networks"
# shellcheck disable=SC2046
lokiw docker network rm -f $(docker network ls -q --filter label="${FENRIR_DOCKER_LABEL}")

loki-log info "+ Volumes"
# shellcheck disable=SC2046
lokiw docker volume rm -f $(docker volume ls -q --filter label="${FENRIR_DOCKER_LABEL}")

loki-log succ "Now the env is destroyed!"
