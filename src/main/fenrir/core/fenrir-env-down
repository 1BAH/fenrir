#! /usr/bin/env loki

##
# Usage:
#   fenrir-env-down [-f]
#
# TODO
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

#include <shift-args>

if [ "$1" = "-f" ]; then
	loki-log warn "FORCE MODE IS ON!"
	force=1
	shift
fi

EXP_ARGC=0
#include <verify-argc>

######################################################################
##                           MAIN PROGRAM                           ##
######################################################################

if [ -n "${force}" ]; then
	"$(fenrir-task-path repo)/env.down"
fi

# Env teardown
if [ -x "${FENRIR_TMP_DIR}/env.down" ]; then
    "${FENRIR_TMP_DIR}/env.down"
    rm "${FENRIR_TMP_DIR}/env.down"
fi

[ -f "${FENRIR_TMP_DIR}/env.conts" ] && while IFS= read -r cont; do
    lokiw docker rm -f "$cont"
done < "${FENRIR_TMP_DIR}/env.conts"

if [ -f "${FENRIR_TMP_DIR}/env" ]; then
    container=$(< "${FENRIR_TMP_DIR}/env")
    lokiw docker rm -f "$container"
fi

lokiw docker volume rm fenrir-shared

rm -f "${FENRIR_TMP_DIR}/env" "${FENRIR_TMP_DIR}/env.conts"
