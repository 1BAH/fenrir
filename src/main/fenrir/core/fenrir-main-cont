#! /usr/bin/env loki

##
# Usage:
#   fenrir-main-cont
#
# Returns id of main container
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

mapfile -t cont < <(docker ps -q --filter label="${FENRIR_DOCKER_LABEL}=main")

if (( ${#cont[@]} == 1 )); then
	echo "${cont[0]}"
else
	exit 13
fi
