#! /usr/bin/env bash

##
# Usage:
#   fenrir-main-cont
#
# Returns id of main container
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

tmp_dir=$(loki -c 'eval' 'echo $FENRIR_TMP_DIR')
if [ -f "${tmp_dir}/env" ]; then
	cat "${tmp_dir}/env"
else
	exit 13
fi
