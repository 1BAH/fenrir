#! /usr/bin/env loki

##
# Usage:
#   fenrir-cont-run OPTS...
#
# docker run wrapper
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

#include <shift-args>

task=$(fenrir-read-conf run task)
cont=$(docker run --label="${FENRIR_DOCKER_LABEL}=extra" --label="${FENRIR_DOCKER_LABEL}.task=${task:-unknown}" "$@")
ecode=$?

if (( ecode != 0 )); then
    exit $ecode
fi

echo "$cont"
