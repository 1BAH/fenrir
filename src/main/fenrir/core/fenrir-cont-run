#! /usr/bin/env loki

##
# Usage:
#   fenrir-cont-run OPTS...
#
# docker run wrapper
##

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

#include <shift-args>

cont=$(docker run --label="${FENRIR_DOCKER_LABEL}=extra" "$@")
ecode=$?

if (( ecode != 0 )); then
    exit $ecode
fi

echo "$cont"
