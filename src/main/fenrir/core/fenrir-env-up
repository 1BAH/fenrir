#! /usr/bin/env loki

##
# Usage:
#   fenrir-env-up [--rm|--unsafe|--bind]
#
# Starts a container with the selected env
##


function finalise {
    local message=$1
    local ecode=${2:-0}

    loki-log fail "$message"
    fenrir-env-down

    exit "$ecode"
}

function cp_file {
    local dir=$1
    local dist=$2

    lokiw docker cp "$dir" "$container:$dist" || {
        finalise "Unable to copy <$dir> to the env" "$?"
    }

    lokiw docker exec -u root "$container" chown fikus -R "$dist" || {
        finalise "Unable to change owner inside the env" "$?"
    }
}

######################################################################
##                         VERIFY ARGUMENTS                         ##
######################################################################

#include <shift-args>

rm_opt=""
privileged=""
bind=""

while [ "$#" -ne 0 ]; do
    case $1 in
        --rm)
            rm_opt="--rm"
            shift
        ;;
        --unsafe)
            privileged="--privileged"
            shift
        ;;
        --bind)
            bind="YES"
            shift
        ;;
        *)
            loki-log err "$(loki-ej-fail)" Unknown parameter: "<$1>"
            exit 16
        ;;
    esac
done

######################################################################
##                          Start container                         ##
######################################################################

task=$(fenrir-read-conf run task)
sol_dir=$(fenrir-read-conf run "root")

image=$(fenrir-read-conf "$task" image)
image=${image:-"ghcr.io/1bah/fenrir-base:latest"}

ENV_HOME="/home/fikus"

docker pull "$image" || {
    loki-log warn "Cannot update image.. Trying to use a cached one instead.."
}

loki-log info "Initialising env.."

######
# == Mount docker socket ???????
# Privileged mode (default when fenrir env) -> DIND
######

loki-log info "Creating a shared directory.."
if docker volume inspect fenrir-shared &> /dev/null; then
	loki-log warn "$(loki-ej-wtf)" "The directory already exists.."
	loki-log warn "Do you want to recreate? [y|N]"

	read -r op
	while true; do
		case "$op" in
			y|Y)
				break
			;;
			""|n|N)
				loki-log err "Terminating.."
				loki-log warn "Destroy the existing env to erase previous artifacts (run 'fenrir env down')"
				exit 6
			;;
			*)
				loki-log fault "$(loki-ej-wtf)" "Unknown option <$op>"
				loki-log fault "Try again.."
			;;
		esac
	done

	# shellcheck disable=SC2046
	lokiw -e docker rm -f $(docker ps -aq --filter "volume=fenrir-shared")
	lokiw -e docker volume rm fenrir-shared
fi

lokiw -e docker volume create --label="${FENRIR_DOCKER_LABEL}=volumes" fenrir-shared

loki-log info "Staring the main container.."

# Testing => safe mode
if [ -z "$bind" ]; then
    container=$(fenrir-cont-run $privileged \
     					-e LOKI_VERBOSE -e FENRIR_IN_ENV=1 -e FENRIR_COPYD=1 $rm_opt \
     					-v fenrir-shared:/tmp/fenrir-shared -d \
     					 "$image" 2> "${ERR_FILE}")
else
    # Solution is mounted in container
    container=$(fenrir-cont-run \
        $privileged \
        -e LOKI_VERBOSE \
        -e FENRIR_IN_ENV=1 \
        --mount "type=bind,src=${sol_dir},dst=${ENV_HOME}/solution" \
        -v fenrir-shared:/tmp/fenrir-shared \
        $rm_opt -d \
        "$image" 2> "${ERR_FILE}")
fi
status=$?

if (( status != 0 )); then
    loki-log fail "$(loki-ej-fail)" "Cannot start docker"
    exit $status
fi

if [ -z "$bind" ]; then
	loki-log info "Copying the solution into env.."
    cp_file "${sol_dir}" "${ENV_HOME}/solution"
fi

######################################################################
##                         Set up container                         ##
######################################################################
loki-log info "Configuring env (installing fenrir).."

# Fenrir
cp_file "$FENRIR_HOME" "${ENV_HOME}"

# Install local fenrir into the container
docker exec -u root "$container" sh -c 'rm -fr $(fenrir-get-confdir) $(fenrir-get-bindir)/fenrir* $(fenrir-get-bindir)/update-fenrir $(fenrir-get-bindir)/uninstall-fenrir $(fenrir-get-bindir)/loki /tmp/fenrir'

cp_file "$(fenrir-get-confdir)" "$(fenrir-get-confdir)"
for file in "$(fenrir-get-bindir)"/fenrir* "$(fenrir-get-bindir)"/update-fenrir "$(fenrir-get-bindir)"/loki; do
    cp_file "$file" "$(fenrir-get-bindir)"
done

# Run config
loki-log info "Fenrir version:" "$(docker exec -u fikus "$container" fenrir v)"

loki-log info "Updating fenrir run configuration.."
lokiw docker exec -u fikus "$container" fenrir-set-conf run blocking "$(fenrir-read-conf run blocking)" || {
    loki-log warn "Fenrir config: <fenrir-set-conf run blocking> has failed!"
}
lokiw docker exec -u fikus "$container" fenrir-set-conf run task "$(fenrir-read-conf run task)" || {
    loki-log warn "Fenrir config: <fenrir-set-conf run task> has failed!"
}
lokiw docker exec -u fikus "$container" fenrir-set-conf run root "${ENV_HOME}/solution" || {
    loki-log warn "Fenrir config: <fenrir-set-conf run root> has failed!"
}

loki-log info "Configuring env (env control files).."

# Env setup
if [ -x "$(fenrir-task-path repo)/env.up" ]; then
    "$(fenrir-task-path repo)/env.up" || {
        finalise "Failed to execute <env.up> file" $?
    }
fi

loki-log info "$(loki-ej-success)" "Env is ready"
