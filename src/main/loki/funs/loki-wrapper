# >-loki-wrapper----------------------------------------------------------------------> #
##
# Usage:
#   loki-get-out
#
# Prints the content of '$OUT_FILE'.
##
function loki-get-out {
    cat "$OUT_FILE"
}


##
# Usage:
#   loki-get-err
#
# Prints the content of '$ERR_FILE'.
##
function loki-get-err {
    cat "$ERR_FILE"
}

##
# Usage:
#   loki-trac pause|resume
#
# Stops and resumes tracing.
##
function loki-trace {
    case "$1" in
        pause)
            JOTUNHEIM_SKIP="YES"
        ;;
        resume)
            JOTUNHEIM_SKIP=""
        ;;
        *)
            echo "loki-trace: Unknown option <$1>"
        ;;
    esac
}

##
# Usage:
#   lokiw [-e] [-u] [CMD]
#
# Stores the command, its stdout and stderr. Preserves the return code.
#
# Options:
#    -e     Exits current shell when the return code is not zero
#    -u     Unsafe mode: uses 'eval $*' instead of '$@'
#           Might have unexpected side-effects from the variable expansion
##
function lokiw {
    local exitable=""
    local unsafe=""

    if [[ "$1" == "-e" ]]; then
        exitable="YES"
        shift
    fi

    if [[ "$1" == "-u" ]]; then
        unsafe="YES"
        shift
    fi

    local JOTUNHEIM_CMD=$*
    #include <jotunheim>

    local ecode
    if [[ -n "$unsafe" ]]; then
        eval "0>&0 $*" > "$OUT_FILE" 2> "$ERR_FILE"
        ecode=$?
    else
        0>&0 "$@" > "$OUT_FILE" 2> "$ERR_FILE"
        ecode=$?
    fi

    if [[ -n "$exitable" ]] && [ $ecode -ne 0 ]; then
        loki-log fail "Failed to execute the command: '$*'"
        exit $ecode
    fi

    return $ecode
}
# <----------------------------------------------------------------------loki-wrapper-< #
