# >>=JOTUNHEIM================================================================TRACING=>> #
# Local variable 'JOTUNHEIM_CMD' must be already initialised with the current cmd

# Skip tracing
if [[ -n "${JOTUNHEIM_SKIP}" ]]; then
    return 0
fi

# Compute symmetric difference of two arrays
local JOTUNHEIM_sym_diff
JOTUNHEIM_sym_diff=$(echo "${JOTUNHEIM[@]}" "${FUNCNAME[@]}" | tr ' ' '\n' | sort | uniq -u)

if [[ "${JOTUNHEIM_LAST_CMD}" == "${JOTUNHEIM_CMD}" ]]; then # INCORRECT FOR literal cmd duplications
    if [[ -z "${JOTUNHEIM_sym_diff}" ]] ||
       [[ "${JOTUNHEIM_CMD}" == "${FUNCNAME[1]}" ]]; then # INCORRECT FOR direct recursive call
        return 0
    fi
fi

local JOTUNHEIM_len=$(( ${#BASH_SOURCE[@]} - 1 ))
{
    local JOTUNHEIM_func_name=${FUNCNAME[1]}
    if [[ "$JOTUNHEIM_func_name" == "source" ]]; then
        echo "[Script '${BASH_SOURCE[1]}']:"
    else
        echo "[Function '$(loki-wrap "${BOLD}" "${JOTUNHEIM_func_name}")'] at ${BASH_SOURCE[1]}:"
    fi

    # Avoid changing outer scope
    local JOTUNHEIM_i
    for (( JOTUNHEIM_i = 2; JOTUNHEIM_i < JOTUNHEIM_len; ++JOTUNHEIM_i )); do
        JOTUNHEIM_func_name=${FUNCNAME[JOTUNHEIM_i]}
        if [[ "$JOTUNHEIM_func_name" == "source" ]]; then
            echo "  in [Script '${BASH_SOURCE[JOTUNHEIM_i]}']:"
        else
            echo "  in [Function '$(loki-wrap "${BOLD}" "${JOTUNHEIM_func_name}")'] at ${BASH_SOURCE[JOTUNHEIM_i]}:"
        fi
    done

    if [ "$LOKI_VERBOSE" = "-v" ]; then
        sed "s|^|    ${MAGENTA}|; s|$|${ENDC}|" <<< "${JOTUNHEIM_CMD}"
    else
        echo -n "    "
        echo "${JOTUNHEIM_CMD}"
    fi
} >> "$CMD_FILE"

JOTUNHEIM_LAST_CMD="$JOTUNHEIM_CMD"
JOTUNHEIM=("${FUNCNAME[@]}")

# <<=TRACING================================================================JOTUNHEIM=<< #
