#! /usr/bin/env bash

# Load rc file:
if type fenrir-get-confdir &> /dev/null; then
    source "$(fenrir-get-confdir)/lokirc" &> /dev/null
else
    echo -e "\033[1m\033[38;5;214m[ WARN  ]\033[0m \033[38;5;209m(シ. .)シ\033[0m Using lokirc's temporal replacement!"
    source "${FENRIR_CONF_DIR}/lokirc" &> /dev/null
fi

set -T
set +m
shopt -s extdebug
shopt -s lastpipe

LOKI_COLUMNS=$(stty size 2> /dev/null || echo "foo 100")
LOKI_COLUMNS=${LOKI_COLUMNS#* }
LOKI_COLUMNS=$(( LOKI_COLUMNS - 10 )) # Add right padding

# Alternative TODO:complete docs!

#include <loki-common-const>
#include <loki-common-funs>

if [ "$1" = "-c" ]; then
    shift
    "$@"
    exit
fi

# IMPORTANT!! DO NOT USE 'JOTUNHEIM_..' AS A NAME FOR VARIABLES!!
JOTUNHEIM_LAST_CMD=""
JOTUNHEIM_SKIP=""
JOTUNHEIM=()

# When no args, we just want to load all global functions and global consts
if (( $# != 0 )); then
    function save_cmd {
        # Sudo might occur during update
        if [ "$(id -u)" -eq 0 ]; then
            return 0
        fi

        if [[ "${BASH_SOURCE[1]}" == "$(fenrir-get-bindir)/loki" ]]; then
            return 0
        fi

        # They are self-responsible for logging
        if [[ $BASH_COMMAND =~ ^loki.*$ || $BASH_COMMAND =~ ^fenrir.*$ ]] ; then
            return 0
        fi

        # Handle shadowing by other commands in subshells
        local JOTUNHEIM_CMD=${BASH_COMMAND}
        #include <jotunheim>
    }

    file=$(realpath "$1")
    export LOKI_CURRENT_FILE=$file
    other=("$@")
    other=("${other[@]:1}")

    if [ "$(id -u)" -ne 0 ] && [[ ! $(basename "$file") =~ ^fenrir.*$ ]]; then
        echo -n > "$CMD_FILE"
        trap 'save_cmd' DEBUG
    fi

    # shellcheck disable=SC1090
    source "$file" "${other[@]}"
fi
